# FirewallGuard AI environment configuration (copy to .env)
# All variables are prefixed FGAI_.

FGAI_ENVIRONMENT=development
FGAI_DEBUG=true

# Storage / brokers
FGAI_DATABASE_URL=postgresql+psycopg://fgai:fgai@localhost:5432/fgai
FGAI_REDIS_URL=redis://localhost:6379/0
FGAI_CELERY_BROKER_URL=redis://localhost:6379/1
FGAI_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object storage: s3 | local
FGAI_STORAGE_BACKEND=local
FGAI_LOCAL_STORAGE_DIR=/var/lib/firewallguard/storage
FGAI_S3_BUCKET=firewallguard-tsr

# Auth - CHANGE THE SECRET IN PRODUCTION
FGAI_JWT_SECRET=change-me-in-production
FGAI_ACCESS_TOKEN_TTL_MINUTES=60
FGAI_REFRESH_TOKEN_TTL_DAYS=14

# Plan limits
FGAI_FREE_TIER_UPLOAD_LIMIT=1
FGAI_MAX_TSR_SIZE_MB=64

# Alerting
FGAI_SMTP_HOST=localhost
FGAI_SMTP_PORT=587
FGAI_ALERT_FROM_ADDRESS=alerts@firewallguard.ai

# Set to 1 to run analyses inline (no Celery broker needed) - dev only
FGAI_INLINE_TASKS=0
